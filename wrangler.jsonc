{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "denisbarbershop",
	"compatibility_date": "2026-11-22",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Vorschau-Schutz bis zum Start (ADR-0011). Zum Start auf "false" setzen.
	// Das Passwort ist ein Secret: npx wrangler secret put PREVIEW_PASSWORD
	"vars": { "SITE_LOCKED": "true" },
	"observability": { "enabled": true },
	"workers_dev": true,
	"preview_urls": true
}
